{
    "name": "Docker",
    "category": "environment",
    "description": "Containerización con Docker y Docker Compose",
    "version": "1.0.0",
    "compatible_with": [
        "python_fastapi",
        "react_vite",
        "react_vite_feature_based",
        "react_vite_typescript"
