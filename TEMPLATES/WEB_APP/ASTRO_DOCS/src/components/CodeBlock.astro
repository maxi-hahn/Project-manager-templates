---
interface Props {
  label?: string;
  code: string;
}

const { label, code } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-border bg-card">
  {label && (
    <div class="border-b border-border px-4 py-2 text-xs font-medium text-neutral-500">
      {label}
    </div>
  )}
  <pre class="overflow-x-auto p-4 text-sm"><code class="font-mono text-neutral-300">{code}</code></pre>
</div>