---
interface Props {
  id?: string;
  title: string;
  content?: string;
}

const { id, title, content } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl border-t border-border px-6 py-16">
  <h2 class="text-2xl font-semibold text-white">{title}</h2>
  {content && <p class="mt-4 max-w-3xl text-neutral-400">{content}</p>}
  <div class="mt-6">
    <slot />
  </div>
</section>